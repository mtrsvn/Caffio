# OTP server environment example

# --- Firebase Admin (required)
# Paste the entire service account JSON as a single-line string (or load it via your deployment secrets manager)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}'

# --- Option A: SendGrid (recommended)
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM=no-reply@yourdomain.com

# --- Option B: SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=<your-app-password>   # create an App Password in Google account security
SMTP_FROM=your-account@gmail.com

# Optional settings
OTP_MAX_ATTEMPTS=5
OTP_EXPIRY_SECONDS=300
